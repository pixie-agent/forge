# 任一 OpenAI 兼容服务均可,复制为 .dev.vars 后填写:
#   OpenAI  : https://api.openai.com/v1                模型如 gpt-4o-mini
#   DeepSeek: https://api.deepseek.com/v1              模型如 deepseek-chat
#   GLM     : https://open.bigmodel.cn/api/paas/v4     模型如 glm-4-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat
# 可选:思考型模型(如 GLM 5.x,始终思考且较慢)的思维链控制,JSON 原样透传:
#LLM_THINKING={"type":"enabled","effort":"low"}
# GLM 追求速度的组合(零思考,首字 ~1s):
#LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#LLM_MODEL=glm-4.5-air
#LLM_THINKING={"type":"disabled"}

# ── Forge 2.0:Agent 执行环境(Google Cloud Run)──
# 注意:上面 LLM_* 现在归 agent 用(部署在 Cloud Run),Worker 本身不再直接调模型
# Cloud Run agent service 地址(本地开发可指向本地跑的 agent,如 http://localhost:8080)
AGENT_URL=http://localhost:8080
# Worker 对外基址(下发给 agent 用于进度回调)
PUBLIC_BASE_URL=http://localhost:8787
# 与 agent 共享的内部密钥(双向 X-Agent-Secret 校验);Cloud Run 侧同名
AGENT_SECRET=dev-agent-secret

# ── 管理后台(独立口令,与普通用户体系隔离)──
# 线上用 `npx wrangler secret put ADMIN_PASSWORD` 配置;未设置则 /admin 与 /api/admin/* 不可用
ADMIN_PASSWORD=dev-admin-password

# ── 多文件产物(Forge 2.0 §13)──
# R2(ARTIFACTS)与 KV(APPDATA)绑定在 wrangler.jsonc;本地由 wrangler 自动模拟,无需在此配置。
# 线上首次搭建:npx wrangler r2 bucket create forge-v2-artifacts
#              npx wrangler kv namespace create forge-v2-appdata → 把 id 填进 wrangler.jsonc
