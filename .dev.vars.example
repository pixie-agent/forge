# Cloudflare Worker 本地变量。复制为 .dev.vars 后填写。
# 真实文件已被 .gitignore 排除，不要提交。

# 本地 Cloud Run Agent 地址
AGENT_URL=http://localhost:8080
# 本地免费和 VIP 通道都必须显式指向本地 Agent；否则会继承 wrangler.jsonc 的生产 AGENT_URL_FREE
AGENT_URL_FREE=http://localhost:8080

# Worker 对外基址，Agent 用它回调进度和最终产物
PUBLIC_BASE_URL=http://localhost:8787

# 与 agent/.env 中 AGENT_SECRET 使用相同的随机值
AGENT_SECRET=replace-with-a-long-random-local-secret

# 管理后台可选。未设置时 /admin 不可用
#ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Google OAuth 可选
#GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=replace-me

# 邮件验证可选。未设置 RESEND_API_KEY 时注册仍建号，但无法发送验证邮件
#RESEND_API_KEY=replace-me
#EMAIL_FROM=noreply@example.com

# 连接器凭证加密可选。使用 32 字节以上随机值
#CONNECTOR_KEK=replace-me

# Creem 计费可选
#CREEM_API_KEY=replace-me
#CREEM_WEBHOOK_SECRET=replace-me

# 本地环境标记可选；生产不设置
#ENVIRONMENT=development

# R2、KV、D1 和 Durable Object 由 wrangler.jsonc 的本地模拟器提供，无需在此配置。
