# Forge Agent(Cloud Run)环境变量示例。生产用 --set-env-vars + Secret Manager 注入

# 与 Cloudflare Worker 共享的内部密钥(Worker 侧同名 AGENT_SECRET),双向 X-Agent-Secret 校验
AGENT_SECRET=change-me

# 模型网关:任一 OpenAI 兼容 或 Anthropic 兼容服务
# OpenAI 兼容(默认方言):
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-key
# Anthropic 兼容示例(DeepSeek):把上面三行换成下面三行,并设置 PI_LLM_API=anthropic-messages
#LLM_BASE_URL=https://api.deepseek.com/anthropic
#LLM_MODEL=deepseek-flash

# LLM 网关 API 方言:openai-completions(默认,OpenAI 兼容)| anthropic-messages(Anthropic 兼容)
#PI_LLM_API=anthropic-messages

# pi 的思考级别:off | minimal | low | medium | high | xhigh
PI_THINKING_LEVEL=medium
# 模型是否支持推理(支持则 pi 会发送 reasoning 参数;不确定时保持 false)
PI_MODEL_REASONING=false
# 思考参数的网关方言:openai | zai(GLM/智谱) | qwen | qwen-chat-template
#PI_THINKING_FORMAT=zai
# 部分网关不认 developer 角色 / reasoning_effort,按需关闭
PI_SUPPORTS_DEVELOPER_ROLE=true
PI_SUPPORTS_REASONING_EFFORT=true

# 单次生成硬超时(毫秒,需小于 Cloud Run --timeout)
AGENT_MAX_RUN_MS=1500000
# 工作目录根(容器内可写)
WORKSPACE_ROOT=/tmp/forge-agent
# pi 自定义 provider 标识
PI_PROVIDER_ID=forge