# Forge Agent 本地变量。复制为 agent/.env 后填写。
# Cloud Run 使用 --set-env-vars 与 Secret Manager，不提交真实 .env。

# 与根目录 .dev.vars 中 AGENT_SECRET 相同
AGENT_SECRET=replace-with-a-long-random-local-secret

# 模型网关。支持 OpenAI Completions、Anthropic Messages 或 OpenAI Responses 方言
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=replace-with-your-model-key
PI_LLM_API=openai-completions

# pi 模型能力
PI_PROVIDER_ID=forge
PI_THINKING_LEVEL=medium
PI_MODEL_REASONING=false
PI_SUPPORTS_DEVELOPER_ROLE=true
PI_SUPPORTS_REASONING_EFFORT=true
#PI_THINKING_FORMAT=zai
#PI_MODEL_INPUT_IMAGE=true
#PI_MAX_TOKENS=16384

# 运行预算必须小于 Cloud Run 请求超时
AGENT_MAX_RUN_MS=1500000
AGENT_DESIGN_REVIEW=generate
AGENT_POLISH_MAX_MS=300000
AGENT_QUEUE_CONCURRENCY=0

# 本地工作目录与模板；从 agent/ 目录直接启动时该相对路径有效
WORKSPACE_ROOT=/tmp/forge-agent
WORKSPACE_TEMPLATE_DIR=./template
