{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 改名 v2:防止本仓库误部署覆盖线上 forge 生产 Worker;架构改稳定后可再定名
  "name": "forge-v2",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-05",
  // 静态资源:构建产物在 web/dist,未命中文件的请求(/api/*、/s/*、SPA 路由)进入 Worker
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS"
  },
  // 对外域名:Custom Domain(不是 route),Cloudflare 自动建 DNS 记录 + 签证书,
  // 前提是 zone 与本 Worker 同账号(1forgen.site 已满足)。根域名 1forgen.site 故意不用,留作以后的官网/落地页。
  // 两个必须一起写的注意点:
  //   1) workers_dev 必须显式 true —— 配置里一旦出现 routes,wrangler 默认把 workers.dev 关掉,
  //      已发布的 /s/:slug 旧链接、以及还没切过去的 Google 回调地址都会断。
  //   2) routes 是「可继承」键(和 vars/d1_databases 那类绑定相反),env.staging 不显式写就会继承
  //      顶层这条 → 发 staging 会去抢 app.1forgen.site;所以两套环境各写各的。见 §11.1 / docs/FORGE2.md
  "workers_dev": true,
  "routes": [{ "pattern": "app.1forgen.site", "custom_domain": true }],
  // 全新独立资源:本 Worker 用全新的 D1,不与线上 forge 共用任何数据
  // 首次搭建:npx wrangler d1 create forge-v2  → 把输出的 database_id 填到下面
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forge-v2",
      "database_id": "6fd724ad-b430-4d2b-9eae-6353c6dbde56"
    }
  ],
  // 构建产物(dist):npx wrangler r2 bucket create forge-v2-artifacts
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "forge-v2-artifacts"
    }
  ],
  // 生成应用的后端键值存储:npx wrangler kv namespace create forge-v2-appdata → 把 id 填到下面
  "kv_namespaces": [
    {
      "binding": "APPDATA",
      "id": "f6b66c90bfa247c6a331bf7ef20e938b"
    }
  ],
  // 每项目 × 每环境一个独立 SQLite 库(Durable Object,SQLite 后端):
  //   - 生成应用的「文档」接口(db/:collection)改为落在该库的每个集合一张表上
  //   - 迁移后的 D1 site_data 作为只读历史源,不再写入
  //   - owner 在工作区「数据 → SQL」里可直接建表/建索引/查询
  // 类名不可随意更名:new_sqlite_classes 迁移一经部署即固化
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_DB", "class_name": "ProjectDb" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectDb"] }
  ],
  // 非密钥变量;AGENT_SECRET 走 `wrangler secret put AGENT_SECRET`
  // 连接器凭证的加密主密钥同理:`wrangler secret put CONNECTOR_KEK`(staging 需 --env staging 另写一次;
  // secret 不可继承,未设置时连接器接口返回明确错误,不影响其他功能)。见 docs/CONNECTORS.md §8
  // AGENT_URL:部署 agent/ 到 Cloud Run 后拿到的服务地址(本地开发在 .dev.vars 覆盖)
  "vars": {
    "AGENT_URL": "https://forge-agent-323709989821.us-central1.run.app",
    // 免费通道的独立执行体(便宜模型 + 进程内 FIFO 排队,见 docs/FORGE2.md §21.5)。
    // **上线前置**:先创建 Secret `llm-api-key-free` 并 `npm run agent:deploy:free:prod`;
    // 服务不存在时免费任务会直接派发失败(不会自动回落 AGENT_URL)。
    // 要临时回退成「免费也走 AGENT_URL」,删掉这一行即可。
    "AGENT_URL_FREE": "https://forge-agent-free-323709989821.us-central1.run.app",
    // 对外规范域名(2026-10-19 切换):Google OAuth 回调 + 连接器回调 + agent 进度回调都以它为准。
    // 换这一行之前必须先在 Google 控制台的 OAuth 客户端里加好对应的「已获授权的重定向 URI」,
    // 否则登录直接 redirect_uri_mismatch(错误发生在 Google 侧,平台收不到回调)。
    // workers.dev 地址仍可用(见上面 workers_dev),但不再是规范地址。
    "PUBLIC_BASE_URL": "https://app.1forgen.site",
    // 计费(MoR = Creem,**非密**配置;密钥走 `wrangler secret put CREEM_API_KEY` / `CREEM_WEBHOOK_SECRET`)。
    // CREEM_PRODUCTS:本地目录 id(src/lib/plans.ts)→ Creem 后台商品 ID 的 JSON 映射。两套门店商品 ID 不同,
    // 所以走 vars 而不是写进代码(AGENTS.md §2)。**留空 = 结账返回「商品未配置」、前端显示「支付通道未开通」**,
    // 建好商品后填真值。webhook 端点登记:`https://app.1forgen.site/api/billing/webhook`
    "CREEM_API_BASE": "https://api.creem.io",
    "CREEM_PRODUCTS": "{\"pack_20\":\"prod_7PHqToX9MC6VFWlmUOO0G0\",\"pack_60\":\"prod_3UuebYQ5fExZvsc2dhzcab\",\"pack_200\":\"prod_1q1K6R0ZUEXwTqmhCLtn89\",\"plan_plus\":\"prod_Fo2vuiv4iVPtfIcZKfg1l\",\"plan_pro\":\"prod_5SVfzmWXCxdEhQBYbIDHxq\"}",
    // 注册验证邮件发件地址;需在 Resend 后台完成域名验证(SPF/DKIM)
    "EMAIL_FROM": "noreply@1forgen.site",
    // Cloudflare Web Analytics beacon token(非密,会出现在前端 HTML 里)。
    // 来源:Dashboard → Web Analytics → 添加 app.1forgen.site → 选「手动 snippet」→ 复制 token。
    // 留空 = 不加载 beacon(功能等于关闭);只配生产,staging 必须留空,否则测试流量会混进生产统计。
    "WEB_ANALYTICS_TOKEN": "8a153a4cc9b14720b525b18806b34ac9"
  },
  // 交付不依赖长连接:agent 在 Cloud Run 跑,通过 /internal 回调写进度与最终结果;
  // cron 每分钟按心跳巡检,执行体失联/超龄的任务判死解锁(见 docs/FORGE2.md)
  "triggers": {
    "crons": ["* * * * *"]
  },

  // ─────────────────────────── STAGING(与生产完全隔离)───────────────────────────
  // 部署:`npm run deploy:staging` → Worker 名 forge-v2-staging(官方规则:环境 Worker = <顶层名>-<环境名>)
  // 顶层配置是生产,一字未动;不带 --env 的 deploy 仍然只部署 forge-v2。
  //
  // 为什么这里要把绑定全部再写一遍:wrangler 规定绑定类配置(vars / d1_databases /
  // kv_namespaces / r2_buckets / durable_objects / secrets)不可继承,必须在每个环境里显式声明。
  // 漏声明不会在部署时报错,而是运行时 c.env.XXX 为 undefined(例如漏 PROJECT_DB 会让
  // 生成应用的 /db 接口和数据面板 500)。main / compatibility_date / assets / migrations /
  // triggers 是可继承的,故意不重复,以免两边漂移。
  "env": {
    "staging": {
      "name": "forge-v2-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "forge-v2-staging",
          "database_id": "da94e0ba-7f9c-48ce-96ca-3160975bf8da"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "forge-v2-artifacts-staging"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "APPDATA",
          "id": "67e46b44ce224ff9a4ea2af583dead21"
        }
      ],
      // 类名与顶层一致(ProjectDb);环境 = 独立 Worker,DO namespace 天然独立,不会读到生产数据
      "durable_objects": {
        "bindings": [{ "name": "PROJECT_DB", "class_name": "ProjectDb" }]
      },
      // 覆盖顶层 routes(routes 是可继承键,不写这里就会继承 app.1forgen.site)
      "routes": [{ "pattern": "app-staging.1forgen.site", "custom_domain": true }],
      "vars": {
        "AGENT_URL": "https://forge-agent-staging-323709989821.us-central1.run.app",
        "AGENT_URL_FREE": "https://forge-agent-free-staging-323709989821.us-central1.run.app",
        "PUBLIC_BASE_URL": "https://app-staging.1forgen.site",
        // 仅 staging 设置;生产不设 → 前端按 production 处理(不显示环境角标)
        "ENVIRONMENT": "staging",
        "EMAIL_FROM": "noreply@1forgen.site",
        // staging 用 Creem **测试门店**(test-api);商品 ID 填 test 模式商品。webhook 端点:
        // https://app-staging.1forgen.site/api/billing/webhook(密钥 staging 单独 put --env staging)
        "CREEM_API_BASE": "https://test-api.creem.io",
        "CREEM_PRODUCTS": "{\"pack_20\":\"prod_2ShRXhW1eAZhLtXoQCZOEq\",\"pack_60\":\"prod_1JTaGgzickEq949Bx0cHSI\",\"pack_200\":\"prod_5bNr2ZVUETd2Aru6Q0nbvE\",\"plan_plus\":\"prod_37ucbu50c9ifHDDWDTQQIl\",\"plan_pro\":\"prod_52HkiGhNmstKT4ruOPvCWi\"}",
        // 故意留空:staging 不加载 Web Analytics,避免测试流量混进生产统计
        "WEB_ANALYTICS_TOKEN": ""
      }
    }
  }
}
