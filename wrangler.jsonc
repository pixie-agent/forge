{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 改名 v2:防止本仓库误部署覆盖线上 forge 生产 Worker;架构改稳定后可再定名
  "name": "forge-v2",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-05",
  // 静态资源:构建产物在 web/dist,未命中文件的请求(/api/*、/s/*、SPA 路由)进入 Worker
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forge",
      // 注意:当前仍指向线上 forge 的 D1(v2 改架构期间共享数据便于对照);
      // 若需要数据隔离:npx wrangler d1 create forge-v2 后替换此 id
      "database_id": "ee014248-414c-4789-a51c-0f8a133621ce"
    }
  ],
  // 生成工作流:持久执行引擎,分段生成整页;实例中断后从最后一个完成的 step 自动恢复,
  // 取代原 waitUntil(免费版 waitUntil 约 2-4 分钟即被回收,撑不住 3~6 分钟的整页生成)
  "workflows": [
    {
      "name": "forge-v2-generation",
      "binding": "GENERATION",
      "class_name": "GenerationWorkflow"
    }
  ],
  // cron 兜底巡检:实例已 errored/实例丢失但任务行仍活动的,判死并解锁项目
  "triggers": {
    "crons": ["* * * * *"]
  }
}
